# --------------------------------------------------------------------------------------
# Build tree (type aware layout)
# --------------------------------------------------------------------------------------
# Ignore everything under build/
build/*
# but keep the portable helper scripts and CMake modules in VCS
!build/install_toolchain.sh
!build/setup.sh
!build/cmake/
!build/cmake/*.cmake

# --------------------------------------------------------------------------------------
# CMake intermediate files (should not be in source root)
# --------------------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Python cache
tools/__pycache__/
